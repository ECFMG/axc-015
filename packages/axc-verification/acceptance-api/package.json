{
	"name": "@axc-verification/acceptance-api",
	"version": "1.0.0",
	"description": "Cucumber Screenplay acceptance tests for the agentCourses API path",
	"private": true,
	"type": "module",
	"scripts": {
		"test:acceptance": "NODE_ENV=test NODE_OPTIONS='--import tsx/esm' cucumber-js && pnpm exec serenity-bdd run --destination ./target/site/serenity",
		"typecheck": "tsgo --noEmit",
		"lint": "biome lint",
		"format": "biome format --write",
		"format:check": "biome format .",
		"clean": "rimraf reports target"
	},
	"dependencies": {
		"@cucumber/cucumber": "catalog:",
		"@serenity-js/assertions": "catalog:",
		"@serenity-js/console-reporter": "catalog:",
		"@serenity-js/core": "catalog:",
		"@serenity-js/rest": "catalog:",
		"@serenity-js/serenity-bdd": "catalog:",
		"@cellix/serenity-framework": "workspace:*"
	},
	"devDependencies": {
		"@cellix/config-typescript": "workspace:*",
		"@cellix/local-dev": "workspace:*",
		"@types/node": "catalog:",
		"rimraf": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:"
	}
}
